<section class="commlink-caller-manager">
  <header class="commlink-caller-manager__header">
    <div>
      <p class="commlink-caller-manager__eyebrow">Commlink directory</p>
      <h2 class="commlink-caller-manager__title">Contacts</h2>
    </div>
    <button type="button" data-action="new">
      <i class="fas fa-plus" aria-hidden="true"></i>
      New
    </button>
  </header>

  <section class="commlink-caller-manager__targets" aria-label="Call recipients">
    <div class="commlink-caller-manager__target-header">
      <h3>Call recipients</h3>
      <button type="button" data-action="toggle-all-targets" class="{{#if allPlayerTargetsSelected}}is-selected{{/if}}">
        <i class="fas fa-users" aria-hidden="true"></i>
        {{#if allPlayerTargetsSelected}}Clear players{{else}}Select players{{/if}}
      </button>
    </div>

    <div class="commlink-caller-manager__target-pills">
      {{#each callTargets}}
        <button type="button" data-action="toggle-target" data-target-id="{{id}}" class="commlink-caller-target-pill {{#if selected}}is-selected{{/if}} {{#if isSelf}}is-self{{/if}}" aria-pressed="{{#if selected}}true{{else}}false{{/if}}">
          <span class="commlink-caller-target-pill__signal" aria-hidden="true"></span>
          <span class="commlink-caller-target-pill__label">{{name}}</span>
        </button>
      {{else}}
        <p class="commlink-caller-manager__empty">No connected recipients available.</p>
      {{/each}}
    </div>
  </section>

  <ol class="commlink-caller-manager__list">
    {{#if isCreating}}
      <li class="commlink-caller-contact commlink-caller-contact--editing">
        <form data-contact-form>
          <div class="commlink-caller-editor__identity">
            <label>
              <span>Name</span>
              <input type="text" name="name" value="{{editorContact.name}}" autocomplete="off" required>
            </label>

            <label>
              <span>Handle</span>
              <input type="text" name="handle" value="{{editorContact.handle}}" autocomplete="off">
            </label>
          </div>

          <label>
            <span>Portrait</span>
            <div class="commlink-caller-editor__file-field">
              <input type="text" name="portrait" value="{{editorContact.portrait}}" autocomplete="off">
              <button type="button" data-action="browse-file" data-target="portrait" data-type="image" aria-label="Browse portrait">
                <i class="fas fa-file-image" aria-hidden="true"></i>
              </button>
            </div>
          </label>

          <label>
            <span>Message</span>
            <textarea name="message" rows="3">{{editorContact.message}}</textarea>
          </label>

          <label>
            <span>Volume</span>
            <input type="range" name="volume" value="{{editorContact.volume}}" min="0" max="1" step="0.05">
          </label>

          <footer class="commlink-caller-editor__actions">
            <button type="submit">
              <i class="fas fa-floppy-disk" aria-hidden="true"></i>
              Save
            </button>
            <button type="button" data-action="cancel">Cancel</button>
          </footer>
        </form>
      </li>
    {{/if}}

    {{#each contacts}}
      <li class="commlink-caller-contact {{#if isEditing}}commlink-caller-contact--editing{{/if}}">
        <div class="commlink-caller-contact__row">
          <div class="commlink-caller-contact__portrait">
            {{#if portrait}}
              <img src="{{portrait}}" alt="{{name}}" loading="lazy">
            {{else}}
              <i class="fas fa-satellite-dish" aria-hidden="true"></i>
            {{/if}}
          </div>

          <div class="commlink-caller-contact__summary">
            <strong>{{name}}</strong>
            {{#if handle}}
              <span>{{handle}}</span>
            {{/if}}
          </div>

          <div class="commlink-caller-contact__actions">
            <button type="button" data-action="call" data-contact-id="{{id}}">
              <i class="fas fa-phone" aria-hidden="true"></i>
              Call
            </button>
            <button type="button" data-action="edit" data-contact-id="{{id}}">
              <i class="fas fa-pen-to-square" aria-hidden="true"></i>
              Edit
            </button>
            <button type="button" data-action="delete" data-contact-id="{{id}}">
              <i class="fas fa-trash" aria-hidden="true"></i>
              Delete
            </button>
          </div>
        </div>

        {{#if isEditing}}
          <form data-contact-form>
            <div class="commlink-caller-editor__identity">
              <label>
                <span>Name</span>
                <input type="text" name="name" value="{{name}}" autocomplete="off" required>
              </label>

              <label>
                <span>Handle</span>
                <input type="text" name="handle" value="{{handle}}" autocomplete="off">
              </label>
            </div>

            <label>
              <span>Portrait</span>
              <div class="commlink-caller-editor__file-field">
                <input type="text" name="portrait" value="{{portrait}}" autocomplete="off">
                <button type="button" data-action="browse-file" data-target="portrait" data-type="image" aria-label="Browse portrait">
                  <i class="fas fa-file-image" aria-hidden="true"></i>
                </button>
              </div>
            </label>

            <label>
              <span>Message</span>
              <textarea name="message" rows="3">{{message}}</textarea>
            </label>

            <label>
              <span>Volume</span>
              <input type="range" name="volume" value="{{volume}}" min="0" max="1" step="0.05">
            </label>

            <footer class="commlink-caller-editor__actions">
              <button type="submit">
                <i class="fas fa-floppy-disk" aria-hidden="true"></i>
                Save
              </button>
              <button type="button" data-action="cancel">Cancel</button>
            </footer>
          </form>
        {{/if}}
      </li>
    {{else}}
      {{#unless isCreating}}
        <li class="commlink-caller-manager__empty">No contacts configured.</li>
      {{/unless}}
    {{/each}}
  </ol>
</section>

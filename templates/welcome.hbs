<section class="commlink-caller-welcome">
  <div class="commlink-caller-welcome__signal">
    <p class="commlink-caller-welcome__eyebrow">Signal acquired</p>
    <h2 class="commlink-caller-welcome__title">{{title}}</h2>
    <p class="commlink-caller-welcome__subtitle">{{subtitle}}</p>
  </div>

  <p class="commlink-caller-welcome__body">
    This bare-bones community module is installed and ready for future comm-link call tools.
  </p>

  <p class="commlink-caller-welcome__next">
    Module id: <code>{{moduleId}}</code>
  </p>
</section>

<form class="commlink-caller-welcome__form" data-welcome-form>
  <section class="commlink-caller-welcome__intro">
    <p class="commlink-caller-welcome__eyebrow">Signal acquired</p>
    <h2>Commlink Caller is ready.</h2>
    <p>
      Build GM-only commlink contacts, choose portraits and ringtones with Foundry's file browser, then call connected players with an incoming-call prompt.
    </p>
  </section>

  <ol class="commlink-caller-welcome__steps">
    <li>Open contacts from the scene-control satellite button, the settings menu, or a macro.</li>
    <li>Add each caller's name, handle, portrait, ringtone, and message.</li>
    <li>Click <strong>Call</strong> to show players the incoming commlink screen.</li>
  </ol>

  <label class="commlink-caller-welcome__preference">
    <input type="checkbox" name="hideWelcome" {{#if hideWelcome}}checked{{/if}}>
    <span>Don't show this again on my next login</span>
  </label>

  <footer class="commlink-caller-welcome__actions">
    <button type="button" data-action="open-contact-manager">
      <i class="fas fa-address-book" aria-hidden="true"></i>
      Open contacts
    </button>
    <button type="submit">
      <i class="fas fa-check" aria-hidden="true"></i>
      Got it
    </button>
  </footer>
</form>

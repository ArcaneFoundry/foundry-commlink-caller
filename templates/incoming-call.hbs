<section class="commlink-caller-incoming">
  {{#if contact.portrait}}
    <div class="commlink-caller-incoming__portrait">
      <img src="{{contact.portrait}}" alt="{{contact.name}}" loading="lazy">
    </div>
  {{/if}}

  <div class="commlink-caller-incoming__body">
    <p class="commlink-caller-incoming__eyebrow">Incoming commlink call</p>
    <h2 class="commlink-caller-incoming__name">{{contact.name}}</h2>
    {{#if contact.handle}}
      <p class="commlink-caller-incoming__handle">{{contact.handle}}</p>
    {{/if}}
    <p class="commlink-caller-incoming__message">{{contact.message}}</p>
  </div>
</section>
